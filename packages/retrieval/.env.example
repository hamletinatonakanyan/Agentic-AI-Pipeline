# retrieval. Real values go in the root .env only. Empty means "use the default".
# Shared names (see the root .env.example): QDRANT_URL, QDRANT_API_KEY.
# Query rewriting also needs OPENAI_API_KEY (see packages/llm/.env.example).
RETRIEVAL_COLLECTION=docs
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=50
RETRIEVAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RETRIEVAL_RRF_K=60
RETRIEVAL_MAX_QUERY_CHARS=2000
RETRIEVAL_REWRITE_QUERIES=3
