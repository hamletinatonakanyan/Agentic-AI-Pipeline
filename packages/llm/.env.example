# llm. Real values go in the root .env only. Empty means "use the default".
# The key is the shared OPENAI_API_KEY (see the root .env.example).
LLM_MODEL=gpt-6-luna
# true sends reasoning.effort "low", false sends "none". One global switch.
# temperature, top_p and logprobs are never sent.
LLM_USE_REASONING=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=
# Prices (USD per million tokens) used only to ESTIMATE cost in traces. Empty = no estimate.
# Copy them from your provider's price list. Reasoning tokens count as output tokens.
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
