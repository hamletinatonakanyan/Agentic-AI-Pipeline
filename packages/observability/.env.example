# observability. Real values go in the root .env only.
OBS_SERVICE_NAME=agentic-blocks
OBS_ENABLED=true
# Comma-separated: local (SQLite trace store), console (one JSON log line per span)
OBS_EXPORTERS=local
OBS_SAMPLE_RATE=1.0
OBS_LOCAL_DB_PATH=data/observability.sqlite
# JSON list of regexes applied to span values before export. Leave unset for the defaults
# (OpenAI-style keys, LlamaCloud-style keys, email addresses).
# OBS_REDACT_PATTERNS=
