# mcp_tools. Real values go in the root .env only. Empty means "use the default".

# --- our own server ---
MCP_SERVER_NAME=agentic-blocks
# Where the stdio server finds retrieval and ingest (the app on port 8000 by default).
# It sends APP_API_KEY, read from the environment or .env, as the X-API-Key header.
MCP_RETRIEVAL_URL=http://localhost:8000/api/retrieval
MCP_INGEST_URL=http://localhost:8000/api/ingest
MCP_DEFAULT_COLLECTION=docs
# Host names the /mcp HTTP endpoint answers to (protection against DNS rebinding).
MCP_HTTP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver

# --- the client ---
MCP_DB_PATH=data/mcp.sqlite
MCP_CALL_TIMEOUT_S=30
MCP_MAX_OUTPUT_CHARS=20000
MCP_MAX_DESCRIPTION_CHARS=1000
MCP_TOOLS_CACHE_TTL_S=60

# --- what a registration may do (the security rules) ---
# Full command lines a stdio registration may run, separated by `;`. Exact match only.
MCP_ALLOWED_COMMANDS=python -m mcp_tools.server
# Hosts an HTTP registration may call.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Variables (by name) a stdio server may receive, and headers an HTTP server may be sent.
MCP_ALLOWED_ENV_REFS=APP_API_KEY,MCP_RETRIEVAL_URL,MCP_INGEST_URL
MCP_ALLOWED_HEADER_REFS=APP_API_KEY

# --- table tools (list_tables, query_table) ---
MCP_TABLE_MAX_CHUNKS=5000     # chunks scanned to find tables
MCP_TABLE_MAX_ROWS=200000     # rows of one table that are loaded
MCP_TABLE_MAX_GROUPS=50       # groups or rows returned at most
