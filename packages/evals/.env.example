# evals. Real values go in the root .env only. Empty means "use the default".
# Shared names (see the root .env.example): QDRANT_URL, QDRANT_API_KEY.
# Drafting questions and the answer metrics also need OPENAI_API_KEY (see packages/llm).
EVAL_DB_PATH=data/evals.sqlite
# Judge and question drafting use LLM_MODEL unless you name another model here.
EVAL_JUDGE_MODEL=
EVAL_JUDGE_PROMPT_VERSION=1
EVAL_DEFAULT_KS=1,3,5,10
EVAL_MAX_GENERATE=200
EVAL_TARGET_TIMEOUT_S=120
# HTTP targets may only call these hosts, and may only send these environment variables as headers.
EVAL_ALLOWED_TARGET_HOSTS=localhost,127.0.0.1
EVAL_ALLOWED_HEADER_REFS=APP_API_KEY
