# ingest. Real values go in the root .env only. Empty means "use the default".

# Shared names (see the root .env.example): QDRANT_URL, QDRANT_API_KEY, LLAMA_CLOUD_API_KEY

# --- PDFs ---
INGEST_PDF_PARSER=llamaparse
INGEST_LLAMAPARSE_TIER=fast
INGEST_LLAMAPARSE_BASE_URL=https://api.cloud.llamaindex.ai
INGEST_LLAMAPARSE_TIMEOUT_S=300
INGEST_SCANNED_TEXT_THRESHOLD=50

# --- Embeddings ---
INGEST_EMBED_MODEL=
INGEST_SPARSE_MODEL=Qdrant/bm25
INGEST_SPARSE_LANGUAGE=english
# Text added before each document / query. Empty = the built-in value for known models
# (Gemma, E5). Set both only for a model that is not known.
INGEST_DOC_PREFIX=
INGEST_QUERY_PREFIX=
INGEST_EMBED_BATCH_SIZE=16

# --- Chunking ---
INGEST_CHUNK_STRATEGY=recursive
INGEST_CHUNK_SIZE=
INGEST_CHUNK_OVERLAP=

# --- Storage and input ---
INGEST_DEFAULT_COLLECTION=docs
INGEST_MANIFEST_PATH=data/ingest_manifest.sqlite
INGEST_ALLOWED_PATHS=
INGEST_MAX_UPLOAD_MB=50
