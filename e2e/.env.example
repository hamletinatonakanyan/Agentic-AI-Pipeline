# e2e variables. Real values go in the root .env only.
# Turn a component off by setting its flag to false.
E2E_ENABLE_INGEST=true
E2E_ENABLE_RETRIEVAL=true
E2E_ENABLE_EVALS=true
E2E_ENABLE_MCP=true
E2E_ENABLE_OBS=true
E2E_ENABLE_AGENT=true
# Shared names (see the root .env.example): APP_API_KEY, QDRANT_URL
