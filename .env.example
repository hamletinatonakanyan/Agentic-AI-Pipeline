# ============================================================
# Agentic Blocks: root environment template
# Copy to .env and fill in your own values. Never commit .env.
# ============================================================

# --- System access -------------------------------------------
# One key for all routes. Clients send it as the X-API-Key header.
APP_API_KEY=

# --- Providers (one key per provider) ------------------------
OPENAI_API_KEY=
LLAMA_CLOUD_API_KEY=

# --- Vector store (Qdrant) -----------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                  # optional for local Docker

# --- LLM (OpenAI gpt-6-luna, reasoning model) ----------------
LLM_MODEL=gpt-6-luna
LLM_USE_REASONING=true           # true = reasoning effort low, false = none
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_PRICE_INPUT_PER_M=           # USD per million tokens, ONLY to estimate cost in traces
LLM_PRICE_OUTPUT_PER_M=          # empty = no estimate. From provider's price list
# temperature, top_p and logprobs are never sent for this model.

# --- Ingest ---------------------------------------------------
# PDFs are routed per page: text pages are read locally, scanned pages go to LlamaParser.
INGEST_PDF_PARSER=llamaparse     # llamaparse | local (local skips scanned pages with a warning)
INGEST_LLAMAPARSE_TIER=fast      # fast | cost_effective | agentic | agentic_plus
INGEST_LLAMAPARSE_BASE_URL=https://api.cloud.llamaindex.ai   # change for another region
INGEST_SCANNED_TEXT_THRESHOLD=50 # characters per page below which a page counts as scanned
# Empty values below mean "use the default".
INGEST_EMBED_MODEL=              # default google/embeddinggemma-300m (768 dims, multilingual)
INGEST_SPARSE_MODEL=Qdrant/bm25
INGEST_SPARSE_LANGUAGE=english   # BM25 language, or none. Users can pick one per ingest in the UI.
INGEST_CHUNK_STRATEGY=recursive  # fixed | recursive | markdown
INGEST_CHUNK_SIZE=               # tokens, default 512
INGEST_CHUNK_OVERLAP=            # tokens, default 64
INGEST_DEFAULT_COLLECTION=docs
INGEST_MANIFEST_PATH=data/ingest_manifest.sqlite
INGEST_ALLOWED_PATHS=            # comma-separated server folders that "ingest path" may read
INGEST_MAX_UPLOAD_MB=50

# --- Retrieval ----------------------------------------------------
RETRIEVAL_COLLECTION=docs
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=50          # fetched before reranking
RETRIEVAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8   # multilingual, 0.57 GB, downloads on first use

# --- Evals --------------------------------------------------------
EVAL_DB_PATH=data/evals.sqlite
EVAL_JUDGE_MODEL=                # empty = use LLM_MODEL
EVAL_DEFAULT_KS=1,3,5,10
EVAL_ALLOWED_TARGET_HOSTS=localhost,127.0.0.1    # HTTP eval targets may only call these
EVAL_ALLOWED_HEADER_REFS=APP_API_KEY             # ...and only send these env vars as headers

# --- MCP tools ---------------------------------------------------
MCP_RETRIEVAL_URL=http://localhost:8000/api/retrieval   # used by the stdio tool server
MCP_INGEST_URL=http://localhost:8000/api/ingest
MCP_ALLOWED_COMMANDS=python -m mcp_tools.server         # commands a registration may run (; separated)
MCP_ALLOWED_HOSTS=localhost,127.0.0.1                    # hosts an HTTP registration may call
MCP_ALLOWED_ENV_REFS=APP_API_KEY,MCP_RETRIEVAL_URL,MCP_INGEST_URL
MCP_ALLOWED_HEADER_REFS=APP_API_KEY
MCP_TABLE_MAX_CHUNKS=5000                                # chunks scanned to find tables
MCP_TABLE_MAX_ROWS=200000                                # rows of one table that are loaded
MCP_TABLE_MAX_GROUPS=50                                  # groups or rows returned at most

# --- Agent ----------------------------------------------------
AGENT_DATA_DIR=data/agent              # checkpoints, memory, caches, thread list
AGENT_CHECKPOINT_BACKEND=sqlite        # sqlite (survives restarts) or memory (forgets at exit)
AGENT_MAX_CHECK_RETRIES=2              # regenerate after a failed self-check
AGENT_MAX_TOOL_ROUNDS=3
AGENT_APPROVAL=sensitive               # sensitive = tools not marked read-only ask first; all; none
AGENT_HISTORY_TURNS=8
AGENT_TOP_K=5
AGENT_USE_CACHE=true                   # LLM-response and retrieval caches (a request can bypass)
AGENT_CACHE_TTL_S=600
AGENT_AUTO_REMEMBER=false              # save facts users state about themselves (off: opt-in)
AGENT_MEMORY_EMBED_MODEL=google/embeddinggemma-300m   # downloads on first use of memory
AGENT_TRACE_CONTENT=true               # put question, passages, tool args/results and the answer in traces
AGENT_TRACE_TEXT_CHARS=4000            # clip each text to this many characters
AGENT_TRACE_PASSAGE_CHARS=500
AGENT_RETRIEVAL_URL=http://localhost:8002             # standalone only
AGENT_MCP_URL=http://localhost:8004                   # standalone only

# --- Observability ------------------------------------------------
OBS_ENABLED=true
OBS_EXPORTERS=local              # local (SQLite) and/or console, comma-separated
OBS_LOCAL_DB_PATH=data/observability.sqlite
OBS_SAMPLE_RATE=1.0

# --- e2e app (turn a component off by setting its flag to false) ---
E2E_ENABLE_INGEST=true
E2E_ENABLE_RETRIEVAL=true
E2E_ENABLE_EVALS=true
E2E_ENABLE_MCP=true
E2E_ENABLE_OBS=true
E2E_ENABLE_AGENT=true

# Each package's own .env.example lists every variable it reads.
